    {
      "type": "text",
      "id": "text-24",
      "x": 54,
      "y": 596,
      "width": 870,
      "height": 35,
      "text": "Per-user isolation is enforced in the query, not layered on in the UI: there is no",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-25",
      "x": 54,
      "y": 628,
      "width": 870,
      "height": 35,
      "text": "endpoint that can return another user's runs. The load test asserts this holds even",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-26",
      "x": 54,
      "y": 660,
      "width": 870,
      "height": 35,
      "text": "when two users' requests are interleaved rapidly.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
